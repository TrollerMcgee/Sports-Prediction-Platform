<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>CloudPlay</title>
    <link rel="stylesheet" href="/style.css">
</head>
<body>

    <nav>
        <a href="/">CloudPlay</a>

        <div>
            <a href="/games">Games</a>
            <a href="/leaderboard">Leaderboard</a>
        </div>
    </nav>

    <main class="hero">
        <p class="label">Cloud-Based Sports Competition</p>

        <h1>Predict games. Earn points. Lead the competition.</h1>

        <p>
            CloudPlay allows sports fans to view upcoming NBA games,
            submit winner predictions, and compete on a points-based
            leaderboard.
        </p>

        <div class="buttons">
            <a class="primary-button" href="/games">View Games</a>

            <a class="secondary-button" href="/leaderboard">
                View Leaderboard
            </a>
        </div>
    </main>

</body>
</html>